#!/usr/bin/env bash
set -euo pipefail

# This script extracts branch coverage data from the SimpleCov JSON output
# and formats it into a more concise representation.
# Usage: bin/branch-coverage
# Output is a JSON array of objects with 'file' and 'branches' keys.
# Each 'branches' value is an array of branch objects with 'start_line', 'end_line',
# 'type', and 'coverage' keys.
# Example output:
# [
#   {
#     "file": "lib/some_file.rb",
#     "branches": [
#       {"start_line": 10, "end_line": 10, "type": "then", "coverage": 3},
#       {"start_line": 10, "end_line": 10, "type": "else", "coverage": 0},
#       ...
#     ]
#   },
#   ...
# ]
# Note: Requires 'jq' to be installed.

project_root="$(realpath "$(dirname "$(realpath "$0")")/..")"
json_path="${project_root}/coverage/coverage.json"

if [[ ! -f "${json_path}" ]]; then
  echo "No coverage.json file found at ${json_path}"
  exit 1
fi

ROOT="${project_root}" jq -r '
  .coverage
  | to_entries
  | map({
    file:
      .key
      | ltrimstr($ENV.ROOT + "/"),
    branches:
      .value.branches
  })' "${json_path}"